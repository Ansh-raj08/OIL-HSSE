# ============================================================
# OIL HSSE ENTERPRISE SIF-PRECURSOR DECISION-SUPPORT PLATFORM
# Backend Environment Configuration (SIH26165)
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000

# Supabase Credentials (PostgreSQL Cloud Persistence)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret / service_role key (sb_secret_... or legacy service_role JWT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Exact frontend origin(s) allowed by CORS (comma-separated, no trailing slash)
# Example for Vercel production: https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum CSV upload size in bytes (default: 4194304 = 4 MB, under Vercel's 4.5 MB serverless payload cap)
MAX_UPLOAD_BYTES=4194304

# Isolated offline unit tests ONLY (never enable in production)
USE_IN_MEMORY_DB=false
